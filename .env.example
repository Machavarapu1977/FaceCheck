# ============================================================
# Face ID + Blockchain Verification — Environment Variables
# ============================================================

# --- Reverse Image Search ---
# Supported providers: serpapi
REVERSE_SEARCH_PROVIDER=serpapi

# SerpAPI key — get yours at https://serpapi.com (250 free searches/month)
# Required for genuine Google Lens reverse image search (DEMO_MODE=false)
SERPAPI_KEY=your_serpapi_key_here

# TinEye API key (optional alternative)
TINEYE_API_KEY=

# --- Matching Thresholds & Weights ---
FACE_SIMILARITY_THRESHOLD=0.60
REVERSE_SEARCH_THRESHOLD=0.50
FACE_WEIGHT=0.60
IMAGE_SEARCH_WEIGHT=0.40

# --- Blockchain Network ---
# For LOCAL development (Hardhat node):
#   BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
#   CHAIN_ID=1337
#   EXPLORER_URL=  (leave blank for local)
#
# For PUBLIC TESTNET (Ethereum Sepolia — RECOMMENDED):
#   BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
#   CHAIN_ID=11155111
#   EXPLORER_URL=https://sepolia.etherscan.io
#
# TESTNET WALLET SETUP:
#   1. Create a new MetaMask wallet — NEVER use your mainnet wallet!
#   2. Get Sepolia ETH from https://sepoliafaucet.com
#   3. Export the private key from MetaMask (Account Details → Export Private Key)
#   4. Paste it below — it stays local and is never committed

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
CHAIN_ID=1337
EXPLORER_URL=

# --- Demo Mode ---
# Set to true  → uses mock search results (shows "Alex Morgan" placeholder data, for testing only)
# Set to false → uses real SerpAPI Google Lens reverse image search (requires SERPAPI_KEY)
DEMO_MODE=false
